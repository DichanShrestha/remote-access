# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://user:password@host:5432/database"

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# OpenRouter Configuration (OpenAI SDK compatible endpoint)
# Primary Chat: anthropic/claude-haiku-5.5
# Text Embeddings: openai/text-embedding-3-small
# Configurable: test with openai/gpt-5-nano, google/gemini-3.1-flash-lite, google/gemini-embedding-001
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_CHAT_MODEL="anthropic/claude-haiku-5.5"
AI_EMBEDDING_MODEL="openai/text-embedding-3-small"

# Optional Legacy / External APIs
JINA_API_KEY="your-jina-api-key"
GEMINI_FREE_API_KEY="your-gemini-free-api-key"

# Payments (Dodo Payments)
DODO_API_KEY="your-dodo-api-key"
DODO_WEBHOOK_SECRET="your-dodo-webhook-secret"
DODO_PRODUCT_SMART_PAGE="pdt_..."
DODO_PRODUCT_SMART_PAGE_AI="pdt_..."

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
