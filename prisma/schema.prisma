generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProfileType {
  CREATOR
  BUSINESS
}

enum PageType {
  HOME
  ABOUT
  SERVICES
  PRODUCTS
  CONTACT
  FAQ
  GALLERY
  BLOG
  CUSTOM
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model User {
  id               String    @id @default(uuid()) @db.Uuid // Matches Supabase auth.users UUID
  email            String?   @unique
  name             String?
  avatarUrl        String?
  trialGrantedAt   DateTime?
  promoCodeUsedAt  DateTime?
  suspendedAt      DateTime?
  suspensionReason String?   @db.Text

  profile       Profile?
  subscriptions Subscription[]
  usage         Usage?

  // Knowchat relations
  bots                 Bot[]
  dataSources          DataSource[]
  chunks               DocumentChunk[]
  qaPairs              QAPair[]
  apiKeys              UserApiKey[]
  catalogItems         CatalogItem[]
  pageMedia            PageMediaAsset[]
  aiRequestUsage       AIRequestUsage[]
  affiliateApplication AffiliateApplication?
  affiliateCodes       AffiliateCode[]       @relation("AffiliateCodes")
  attributedReferral   CustomerReferral?     @relation("ReferredCustomer")
  commissions          Commission[]          @relation("CommissionAffiliate")
  referralsMade        CustomerReferral[]    @relation("ReferralAffiliate")
  affiliatePurchases   AffiliatePurchase[]   @relation("CustomerPurchases")
  affiliatePayouts     AffiliatePayout[]     @relation("AffiliatePayouts")
  planAccessRequests   PlanAccessRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Profile {
  id          String      @id @default(cuid())
  userId      String      @unique @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ProfileType @default(CREATOR)
  username    String      @unique
  displayName String
  bio         String?
  avatarUrl   String?

  pages             Page[]
  website           Website?
  slugRedirects     PageSlugRedirect[]
  blogArticles      BlogArticle[]
  blogSlugRedirects BlogArticleSlugRedirect[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Shared website design for a business. This is the single source of truth for
/// the theme, header, footer, and global settings used by every page.
model Website {
  id        String  @id @default(cuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  draftConfig     Json  @default("{}")
  publishedConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Page {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title            String   @default("")
  slug             String   @default("")
  pageType         PageType @default(CUSTOM)
  showInNavigation Boolean  @default(true)
  navOrder         Int      @default(0)

  draftConfig     Json    @default("{}")
  publishedConfig Json?
  isPublished     Boolean @default(false)

  /// Published SEO snapshot used by the sitemap. The editable values live in
  /// the page document settings so draft changes never leak into live metadata.
  canonicalUrl String?
  noindex      Boolean   @default(false)
  publishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads         Lead[]
  slugRedirects PageSlugRedirect[]

  botId String? @unique @db.Uuid
  bot   Bot?    @relation(fields: [botId], references: [id])

  @@unique([profileId, slug])
  @@index([profileId, pageType])
  @@index([profileId, isPublished, showInNavigation, navOrder])
  @@index([isPublished, noindex, updatedAt])
}

/// Tenant-scoped redirects so changing a page slug never breaks old links and
/// can never resolve to another business's page.
model PageSlugRedirect {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug      String
  createdAt DateTime @default(now())

  @@unique([profileId, slug])
  @@index([pageId])
}

/// Long-form editorial content for a business or creator.
///
/// The editable fields are the draft. When an article is published, a
/// serialisable snapshot is written to `publishedSnapshot` and the public slug,
/// canonical and noindex values are mirrored into queryable columns. Autosave
/// therefore never changes a live article until the owner explicitly publishes
/// or updates it.
model BlogArticle {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title            String   @default("")
  slug             String
  excerpt          String   @default("") @db.Text
  bodyHtml         String   @default("") @db.Text
  featuredImageUrl String?
  featuredImageAlt String?
  categories       String[] @default([])
  tags             String[] @default([])
  authorName       String   @default("")
  authorAvatarUrl  String?

  status       BlogStatus @default(DRAFT)
  scheduledFor DateTime?
  publishedAt  DateTime?

  /// Stable slug used by the published URL. Kept separate from the editable
  /// draft slug so a slug change does not break a live article until republish.
  publicSlug String?

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogImage        String?
  noindex        Boolean @default(false)

  publishedSnapshot     Json?
  publishedNoindex      Boolean @default(false)
  publishedCanonicalUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slugRedirects BlogArticleSlugRedirect[]

  @@unique([profileId, slug])
  @@unique([profileId, publicSlug])
  @@index([profileId, status, updatedAt])
  @@index([profileId, status, publishedAt])
  @@index([status, scheduledFor])
  @@index([status, publicSlug])
}

/// Tenant-scoped redirects for article URL changes. A redirect can never point
/// at another tenant's article.
model BlogArticleSlugRedirect {
  id        String      @id @default(cuid())
  profileId String
  profile   Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  articleId String
  article   BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  slug      String
  createdAt DateTime    @default(now())

  @@unique([profileId, slug])
  @@index([articleId])
}

model Subscription {
  id            String @id @default(cuid())
  userId        String @db.Uuid
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  status        String // trialing, active, past_due, canceled, expired
  billingMethod String @default("none") // none, dodo, manual

  currentPeriodEnd     DateTime?
  currentPeriodStart   DateTime?
  trialEverGranted     Boolean   @default(false)
  aiRepliesUsed        Int       @default(0)
  aiRepliesReserved    Int       @default(0)
  aiRepliesPeriodStart DateTime?
  lastProviderEventAt  DateTime?
  aiAccessEndedAt      DateTime?
  aiKnowledgePurgedAt  DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  dodoCustomerId     String?
  dodoSubscriptionId String? @unique

  // Knowchat fields
  tier             String   @default("free") // free, starter, pro, business
  creditWallet     Int      @default(0) @map("credit_wallet")
  monthlyResetDate DateTime @default(now()) @map("monthly_reset_date") @db.Timestamptz(6)

  affiliatePurchases AffiliatePurchase[]
  commissions        Commission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanAccessRequest {
  id              String    @id @default(cuid())
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  requestType     String
  planId          String
  currency        String
  quotedAmount    Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(12, 2)
  referralCode    String?
  affiliateId     String?   @db.Uuid
  status          String    @default("pending")
  requestedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?   @db.Uuid
  reviewReason    String?   @db.Text

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
  @@map("plan_access_requests")
}

model AffiliateApplication {
  id           String         @id @default(cuid())
  userId       String         @unique @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String         @default("pending")
  basedInNepal Boolean        @default(false)
  details      String?        @db.Text
  reviewedBy   String?        @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  code         AffiliateCode?

  @@index([status, createdAt])
  @@map("affiliate_applications")
}

model AffiliateCode {
  id            String                @id @default(cuid())
  affiliateId   String                @db.Uuid
  affiliate     User                  @relation("AffiliateCodes", fields: [affiliateId], references: [id], onDelete: Restrict)
  code          String                @unique
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  referrals     CustomerReferral[]
  applicationId String?               @unique
  application   AffiliateApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([affiliateId, active])
  @@map("affiliate_codes")
}

model CustomerReferral {
  id           String              @id @default(cuid())
  affiliateId  String              @db.Uuid
  affiliate    User                @relation("ReferralAffiliate", fields: [affiliateId], references: [id], onDelete: Restrict)
  customerId   String              @unique @db.Uuid
  customer     User                @relation("ReferredCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  codeId       String
  code         AffiliateCode       @relation(fields: [codeId], references: [id], onDelete: Restrict)
  referredAt   DateTime            @default(now())
  firstPaidAt  DateTime?
  discountUsed Boolean             @default(false)
  purchases    AffiliatePurchase[]
  commissions  Commission[]

  @@index([affiliateId, referredAt])
  @@map("customer_referrals")
}

model AffiliatePurchase {
  id                  String            @id @default(cuid())
  customerId          String            @db.Uuid
  customer            User              @relation("CustomerPurchases", fields: [customerId], references: [id], onDelete: Restrict)
  referralId          String?
  referral            CustomerReferral? @relation(fields: [referralId], references: [id], onDelete: Restrict)
  subscriptionId      String?
  subscription        Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId              String
  paymentProvider     String            @default("manual")
  currency            String
  originalAmount      Decimal           @db.Decimal(12, 2)
  discountPercent     Decimal           @default(0) @db.Decimal(5, 2)
  discountAmount      Decimal           @default(0) @db.Decimal(12, 2)
  expectedAmount      Decimal           @db.Decimal(12, 2)
  paymentReference    String?           @unique
  proofUrl            String?
  status              String            @default("pending")
  verifiedAmount      Decimal?          @db.Decimal(12, 2)
  verifiedAt          DateTime?
  verifiedBy          String?           @db.Uuid
  customerConfirmedAt DateTime?
  resolutionNote      String?           @db.Text
  paymentDate         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  commission          Commission?

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("affiliate_purchases")
}

model Commission {
  id                String               @id @default(cuid())
  affiliateId       String               @db.Uuid
  affiliate         User                 @relation("CommissionAffiliate", fields: [affiliateId], references: [id], onDelete: Restrict)
  referralId        String
  referral          CustomerReferral     @relation(fields: [referralId], references: [id], onDelete: Restrict)
  purchaseId        String               @unique
  purchase          AffiliatePurchase    @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  subscriptionId    String?
  subscription      Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  currency          String
  eligibleRevenue   Decimal              @db.Decimal(12, 2)
  commissionPercent Decimal              @db.Decimal(5, 2)
  amount            Decimal              @db.Decimal(12, 2)
  earnedAt          DateTime
  eligibilityEndsAt DateTime
  eligibilityStatus String               @default("payable")
  payoutStatus      String               @default("unpaid")
  reversalReference String?
  reversedAt        DateTime?
  payoutId          String?
  payout            AffiliatePayout?     @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  reversals         CommissionReversal[]
  createdAt         DateTime             @default(now())

  @@index([affiliateId, currency, payoutStatus])
  @@index([referralId, earnedAt])
  @@map("commissions")
}

model CommissionReversal {
  id                 String     @id @default(cuid())
  commissionId       String
  commission         Commission @relation(fields: [commissionId], references: [id], onDelete: Restrict)
  refundReference    String     @unique
  refundAmount       Decimal    @db.Decimal(12, 2)
  commissionAmount   Decimal    @db.Decimal(12, 2)
  refundCurrency     String
  commissionCurrency String
  createdAt          DateTime   @default(now())

  @@index([commissionId, createdAt])
  @@map("commission_reversals")
}

model AffiliatePayout {
  id             String       @id @default(cuid())
  affiliateId    String       @db.Uuid
  affiliate      User         @relation("AffiliatePayouts", fields: [affiliateId], references: [id], onDelete: Restrict)
  currency       String
  amount         Decimal      @db.Decimal(12, 2)
  payoutAmount   Decimal?     @db.Decimal(12, 2)
  payoutCurrency String?
  exchangeRate   Decimal?     @db.Decimal(18, 8)
  method         String
  reference      String
  status         String       @default("paid")
  paidAt         DateTime
  createdBy      String       @db.Uuid
  createdAt      DateTime     @default(now())
  commissions    Commission[]

  @@index([affiliateId, paidAt])
  @@map("affiliate_payouts")
}

model AffiliateConfig {
  id                      Int      @id @default(1)
  customerDiscountPercent Decimal  @default(10) @db.Decimal(5, 2)
  commissionPercent       Decimal  @default(15) @db.Decimal(5, 2)
  eligibilityMonths       Int      @default(12)
  updatedBy               String?  @db.Uuid
  updatedAt               DateTime @updatedAt

  @@map("affiliate_config")
}

model AffiliateAuditEvent {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("affiliate_audit_events")
}

model Usage {
  id              String @id @default(cuid())
  userId          String @unique @db.Uuid
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pageGenerations Int    @default(0)
  aiEdits         Int    @default(0)
  chatMessages    Int    @default(0)

  // Knowchat fields
  monthlyMessages  Int    @default(0) @map("monthly_messages")
  storageUsedBytes Int    @default(0) @map("storage_used_bytes")
  pageMediaBytes   BigInt @default(0)
  knowledgeBytes   BigInt @default(0)
  indexedTokens    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  provider  String
  type      String
  status    String
  createdAt DateTime @default(now())
}

model AIRequestUsage {
  id           String   @id @default(cuid())
  requestId    String   @unique
  userId       String   @db.Uuid
  botId        String   @db.Uuid
  modelId      String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 8)
  status       String
  error        String?
  retryCount   Int      @default(0)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot          Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_request_usage")
}

model PageMediaAsset {
  id          String   @id @default(cuid())
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket      String
  objectKey   String
  sizeBytes   BigInt
  contentType String
  createdAt   DateTime @default(now())

  @@unique([bucket, objectKey])
  @@index([userId])
  @@map("page_media_assets")
}

model Lead {
  id            String @id @default(cuid())
  pageId        String
  page          Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  componentId   String
  componentType String

  name       String?
  email      String?
  phone      String?
  message    String? @db.Text
  customData Json?

  source      String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, createdAt])
}

model Bot {
  id                String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  name              String
  description       String?
  systemPrompt      String           @default("") @map("system_prompt")
  welcomeMessage    String           @default("Hi! How can I help you today?") @map("welcome_message")
  welcomeMessages   String[]         @default([]) @map("welcome_messages")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  avatarEmoji       String           @default("bot") @map("avatar_emoji")
  collectLeads      Boolean          @default(false) @map("collect_leads")
  colorTheme        String           @default("#6366f1") @map("color_theme")
  purpose           String           @default("general")
  removeWatermark   Boolean          @default(false) @map("remove_watermark")
  status            String           @default("draft")
  tone              String           @default("friendly")
  avatarUrl         String?          @map("avatar_url")
  bookingLink       String?          @map("booking_link")
  leadGenConfig     Json?            @map("lead_gen_config")
  leadCaptureConfig Json?            @map("lead_capture_config")
  rateLimitMessage  String           @default("Too many messages in a row") @map("rate_limit_message")
  rateLimitMessages Int              @default(20) @map("rate_limit_messages")
  rateLimitWindow   Int              @default(240) @map("rate_limit_window")
  temperature       Float            @default(0.7) @map("temperature")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessages      ChatMessage[]
  dataSources       DataSource[]
  chunks            DocumentChunk[]
  leads             BotLead[]
  qaPairs           QAPair[]
  catalogItems      CatalogItem[]
  bookingEvents     BookingEvent[]
  aiRequestUsage    AIRequestUsage[]

  page Page?

  @@index([userId, updatedAt])
  @@index([status])
  @@map("bots")
}

model DataSource {
  id           String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId        String          @map("bot_id") @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  type         String
  source       String
  status       String          @default("pending")
  errorMessage String?         @map("error_message")
  filePath     String?         @map("file_path")
  metadata     Json?
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bot          Bot             @relation(fields: [botId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]

  @@index([botId, userId])
  @@index([status])
  @@map("data_sources")
}

model DocumentChunk {
  id           String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId        String                 @map("bot_id") @db.Uuid
  content      String
  embedding    Unsupported("vector")?
  metadata     Json?
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  dataSourceId String                 @map("data_source_id") @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  bot          Bot                    @relation(fields: [botId], references: [id], onDelete: Cascade)
  dataSource   DataSource             @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([dataSourceId])
  @@index([userId])
  @@map("document_chunks")
}

model UserApiKey {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  provider     String   @default("openai")
  encryptedKey String   @map("encrypted_key")
  keyHint      String   @default("") @map("key_hint")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("user_api_keys")
}

model ChatMessage {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId     String   @map("bot_id") @db.Uuid
  sessionId String   @map("session_id")
  visitorId String?  @map("visitor_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, sessionId, createdAt])
  @@index([botId])
  @@index([botId, visitorId])
  @@map("chat_messages")
}

model BotLead {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId               String   @map("bot_id") @db.Uuid
  visitorId           String?  @map("visitor_id")
  name                String?
  email               String?
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  conversationSnippet String?  @map("conversation_snippet") @db.Text
  phone               String?
  bot                 Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([createdAt])
  @@index([botId, visitorId])
  @@map("bot_leads")
}

model QAPair {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId      String   @map("bot_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  questions  String[]
  answer     String
  usageCount Int      @default(0) @map("usage_count")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([botId, userId])
  @@map("qa_pairs")
}

model CatalogItem {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId          String   @map("bot_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  title          String   @default("Untitled")
  description    String?
  triggerQueries String[] @default([]) @map("trigger_queries")
  category       String?
  status         String   @default("processing")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  price          Float?   @map("price")
  currency       String?  @map("currency")

  publicUrl   String? @map("public_url")
  redirectUrl String? @map("redirect_url")

  images CatalogImage[]
  bot    Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@index([userId])
  @@map("catalog_items")
}

model CatalogImage {
  id            String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  catalogItemId String                       @map("catalog_item_id") @db.Uuid
  publicUrl     String                       @map("public_url")
  caption       String?
  order         Int                          @default(0)
  status        String                       @default("processing")
  sizeBytes     BigInt                       @default(0) @map("size_bytes")
  embedding     Unsupported("vector(3072)")?
  createdAt     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([catalogItemId])
  @@map("catalog_images")
}

model BookingEvent {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  botId     String   @map("bot_id") @db.Uuid
  event     String // "booking_link_shown" | "booking_link_clicked"
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId, event])
  @@index([botId, createdAt])
  @@map("booking_events")
}
